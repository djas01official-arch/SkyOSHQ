DATABASE_URL="postgresql://skyos:skyos_local_only@localhost:5432/skyos?schema=public"
AUTH_SECRET="replace-with-a-local-random-secret"
AUTH_DEV_EMAIL="developer@skyos.local"
AUTH_DEV_PASSWORD="change-this-development-password"
# Production Google OIDC only. Keep these server-side and inject real values
# through the production secret facility; local development does not require them.
# AUTH_GOOGLE_ID="google-oauth-client-id"
# AUTH_GOOGLE_SECRET="google-oauth-client-secret"
POSTGRES_DB="skyos"
POSTGRES_USER="skyos"
POSTGRES_PASSWORD="skyos_local_only"
DATABASE_TEST_URL="postgresql://skyos_test:skyos_test_local_only@localhost:5433/skyos_test?schema=public"
POSTGRES_TEST_DB="skyos_test"
POSTGRES_TEST_USER="skyos_test"
POSTGRES_TEST_PASSWORD="skyos_test_local_only"
# Development/test storage only. Production requires provider="gcs" and a
# private bucket configured by deployment metadata, never a service-account key.
KNOWLEDGE_STORAGE_PROVIDER="local"
KNOWLEDGE_STORAGE_ROOT=".skyos/knowledge"
# KNOWLEDGE_GCS_BUCKET="<private-production-bucket>"
KNOWLEDGE_MAX_FILE_SIZE_BYTES="10485760"
# Optional Next.js development-only LAN/browser host allowlist. Use comma-separated hostnames or IPv4 addresses; never commit a real LAN IP.
SKYOS_DEV_ALLOWED_ORIGINS=""
BACKGROUND_JOB_MODE="synchronous"
BACKGROUND_JOB_LEASE_MS="60000"
BACKGROUND_JOB_POLL_MS="1000"
BACKGROUND_JOB_RECOVERY_MS="30000"
BACKGROUND_JOB_BACKOFF_BASE_MS="1000"
BACKGROUND_JOB_BACKOFF_MAX_MS="60000"
EMBEDDING_PROVIDER="local"
AI_PROVIDER="local"
AI_MODEL="gpt-5.6-terra"
# Use AI_MODEL="claude-sonnet-5" with AI_PROVIDER="anthropic". The pinned
# claude-sonnet-4-6 model remains approved for explicit regression runs.
# Use AI_MODEL="gemini-3.6-flash" with AI_PROVIDER="gemini".
# OPENAI_API_KEY="<server-secret>" # Server-only; required only with AI_PROVIDER="openai".
# ANTHROPIC_API_KEY="<server-secret>" # Server-only; required only with AI_PROVIDER="anthropic".
# GEMINI_API_KEY="<server-secret>" # Server-only; required only with AI_PROVIDER="gemini".
# SKYOS_ALLOW_LIVE_AI_EVAL="1" # Manual staging evaluator only; never enable in application or CI configuration.
KNOWLEDGE_SEARCH_TIMEOUT_MS="3000"
KNOWLEDGE_SEARCH_MAX_RESULTS="50"
KNOWLEDGE_SEARCH_PER_SOURCE_LIMIT="3"
KNOWLEDGE_RETRIEVAL_MAX_RESULTS="8"
KNOWLEDGE_RETRIEVAL_TOTAL_CHARACTERS="6000"
KNOWLEDGE_RETRIEVAL_PER_SOURCE_CHARACTERS="2500"
KNOWLEDGE_RETRIEVAL_NEIGHBOR_RADIUS="1"
