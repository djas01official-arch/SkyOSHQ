generator client {
  provider        = "prisma-client"
  output          = "../generated/client"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum KnowledgeDocumentStatus {
  ACTIVE
  ARCHIVED
}

enum KnowledgeAttachmentStatus {
  ACTIVE
  ARCHIVED
}

enum KnowledgeAttachmentProcessingStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum DocumentProcessingJobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum KnowledgeChunkSourceType {
  MARKDOWN_DOCUMENT
  ATTACHMENT_EXTRACTION
}

enum KnowledgeChunkingJobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum BackgroundJobKind {
  DOCUMENT_EXTRACTION
  KNOWLEDGE_CHUNKING
  KNOWLEDGE_EMBEDDING
}

enum BackgroundJobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum BackgroundJobAttemptOutcome {
  SUCCEEDED
  RETRY_SCHEDULED
  FAILED
  LEASE_EXPIRED
}

enum KnowledgeEmbeddingJobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum AiConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum AiRunStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum AiKnowledgeActionType {
  SUMMARIZE
  EXTRACT_ACTION_ITEMS
  IDENTIFY_RISKS
  EXTRACT_KEY_DECISIONS
}

enum AiGroundedContextSourceType {
  WORKSPACE_RETRIEVAL
  KNOWLEDGE_DOCUMENT_VERSION
}

enum AiOrchestrationMode {
  FAST
  BALANCED
  DEEP
  CRITICAL
}

enum AiOrchestrationRole {
  CANDIDATE
  CRITIC
  VERIFIER
  SYNTHESIZER
}

enum AiOrchestrationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIALLY_SUCCEEDED
  FAILED
  CANCELLED
}

enum AiRoutingConfiguredMode {
  AUTO
  FAST
  BALANCED
  DEEP
  CRITICAL
}

enum AiTaskComplexity {
  NOT_ANALYZED
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum AiTaskRisk {
  NOT_ANALYZED
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AiTaskAmbiguity {
  NOT_ANALYZED
  LOW
  MEDIUM
  HIGH
}

enum AiTaskVerificationNeed {
  NOT_ANALYZED
  LOW
  MEDIUM
  HIGH
}

enum AiTaskExpectedEffort {
  NOT_ANALYZED
  SMALL
  MEDIUM
  LARGE
}

enum AiTaskRoutingReason {
  EXPLICIT_MODE
  CRITICAL_RISK
  HIGH_RISK
  HIGH_VERIFICATION_NEED
  VERY_HIGH_COMPLEXITY
  HIGH_COMPLEXITY
  HIGH_AMBIGUITY
  LARGE_EXPECTED_EFFORT
  MODERATE_RISK
  MODERATE_COMPLEXITY
  MODERATE_AMBIGUITY
  MODERATE_VERIFICATION_NEED
  MODERATE_EXPECTED_EFFORT
  LOW_COMPLEXITY
}

enum AiTaskAnalysisSignal {
  EXPLICIT_MODE
  SHORT_REQUEST
  LONG_REQUEST
  LARGE_INPUT
  MULTI_STEP_REQUEST
  MULTIPLE_DELIVERABLES
  STRUCTURED_INPUT
  COMPARISON_REQUEST
  CHECK_REQUEST
  REVIEW_REQUEST
  VERIFICATION_REQUEST
  AUDIT_REQUEST
  EXPLICIT_DEEP_ANALYSIS
  AMBIGUITY_SIGNAL
  OPERATIONAL_RISK_REQUEST
  HIGH_STAKES_REQUEST
  CRITICAL_STAKES_REQUEST
  EMBEDDED_UNTRUSTED_CONTENT
}

enum AiBudgetLedgerEntryType {
  CREDIT
  DEBIT
}

enum AiBudgetReservationStatus {
  RESERVED
  SETTLED
  RELEASED
}

enum AiBudgetConfirmationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AiBudgetExecutionClaimStatus {
  READY
  STARTED
  FINISHED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                             String                     @id @default(uuid()) @db.Uuid
  name                           String?
  email                          String?                    @unique
  emailVerified                  DateTime?                  @db.Timestamptz(6)
  image                          String?
  passwordHash                   String?                    @db.Text
  identitySubject                String?                    @unique
  displayName                    String?
  status                         UserStatus                 @default(ACTIVE)
  deletedAt                      DateTime?                  @db.Timestamptz(6)
  createdAt                      DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime                   @updatedAt @db.Timestamptz(6)
  createdOrganizations           Organization[]             @relation("OrganizationCreator")
  createdWorkspaces              Workspace[]                @relation("WorkspaceCreator")
  accounts                       Account[]
  auditEvents                    AuditEvent[]               @relation("AuditActor")
  knowledgeDocuments             KnowledgeDocument[]        @relation("KnowledgeDocumentAuthor")
  knowledgeDocumentVersions      KnowledgeDocumentVersion[] @relation("KnowledgeDocumentVersionAuthor")
  knowledgeAttachments           KnowledgeAttachment[]      @relation("KnowledgeAttachmentUploader")
  documentProcessingJobs         DocumentProcessingJob[]    @relation("DocumentProcessingJobRequester")
  knowledgeChunkingJobs          KnowledgeChunkingJob[]     @relation("KnowledgeChunkingJobRequester")
  backgroundJobs                 BackgroundJob[]            @relation("BackgroundJobRequester")
  knowledgeEmbeddingJobs         KnowledgeEmbeddingJob[]    @relation("KnowledgeEmbeddingJobRequester")
  aiConversations                AiConversation[]           @relation("AiConversationOwner")
  aiMessages                     AiMessage[]                @relation("AiMessageAuthor")
  aiRuns                         AiRun[]                    @relation("AiRunRequester")
  aiGroundedContexts             AiRetrievalSnapshot[]      @relation("AiGroundedContextCreator")
  aiOrchestrations               AiOrchestration[]          @relation("AiOrchestrationCreator")
  aiBudgetConfirmationsRequested AiBudgetConfirmation[]     @relation("AiBudgetConfirmationRequester")
  aiBudgetConfirmationsDecided   AiBudgetConfirmation[]     @relation("AiBudgetConfirmationDecider")
  aiBudgetExecutionClaims        AiBudgetExecutionClaim[]   @relation("AiBudgetExecutionClaimant")
  createdTasks                   Task[]                     @relation("TaskCreator")
  assignedTasks                  Task[]                     @relation("TaskAssignee")
  organizationMemberships        OrganizationMembership[]
  sessions                       Session[]
  workspaceMemberships           WorkspaceMembership[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  actorUserId    String       @db.Uuid
  organizationId String       @db.Uuid
  workspaceId    String?      @db.Uuid
  action         String
  targetType     String
  targetId       String       @db.Uuid
  metadata       Json         @default("{}") @db.JsonB
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  actor          User         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workspace      Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_events")
}

model Organization {
  id               String                   @id @default(uuid()) @db.Uuid
  name             String
  slug             String
  status           OrganizationStatus       @default(ACTIVE)
  archivedAt       DateTime?                @db.Timestamptz(6)
  deletedAt        DateTime?                @db.Timestamptz(6)
  createdByUserId  String?                  @db.Uuid
  createdAt        DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(6)
  createdBy        User?                    @relation("OrganizationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memberships      OrganizationMembership[]
  auditEvents      AuditEvent[]
  workspaces       Workspace[]
  aiOrchestrations AiOrchestration[]

  @@unique([slug], map: "organizations_active_slug_key", where: raw("((status = 'ACTIVE'::\"OrganizationStatus\") AND (\"deletedAt\" IS NULL))"))
  @@index([status])
  @@index([deletedAt])
  @@index([createdByUserId])
  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  activatedAt    DateTime?        @db.Timestamptz(6)
  revokedAt      DateTime?        @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId, status, role])
  @@index([userId, status])
  @@map("organization_memberships")
}

model Workspace {
  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @db.Uuid
  name                   String
  slug                   String
  status                 WorkspaceStatus         @default(ACTIVE)
  archivedAt             DateTime?               @db.Timestamptz(6)
  deletedAt              DateTime?               @db.Timestamptz(6)
  createdByUserId        String?                 @db.Uuid
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  createdBy              User?                   @relation("WorkspaceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memberships            WorkspaceMembership[]
  auditEvents            AuditEvent[]
  knowledgeDocuments     KnowledgeDocument[]
  knowledgeAttachments   KnowledgeAttachment[]
  knowledgeChunkingJobs  KnowledgeChunkingJob[]
  knowledgeChunkSets     KnowledgeChunkSet[]
  backgroundJobs         BackgroundJob[]
  knowledgeEmbeddingJobs KnowledgeEmbeddingJob[]
  knowledgeEmbeddingSets KnowledgeEmbeddingSet[]
  aiConversations        AiConversation[]
  aiMessages             AiMessage[]
  aiRuns                 AiRun[]
  aiRetrievalSnapshots   AiRetrievalSnapshot[]
  aiOrchestrations       AiOrchestration[]
  aiRoutingDecisions     AiRoutingDecision[]
  aiBudgetAccount        AiBudgetAccount?
  aiBudgetLedgerEntries  AiBudgetLedgerEntry[]
  aiBudgetReservations   AiBudgetReservation[]
  aiBudgetConfirmations  AiBudgetConfirmation[]
  aiBudgetExecutionClaims AiBudgetExecutionClaim[]
  tasks                  Task[]

  @@unique([organizationId, slug], map: "workspaces_active_organization_slug_key", where: raw("((status = 'ACTIVE'::\"WorkspaceStatus\") AND (\"deletedAt\" IS NULL))"))
  @@index([organizationId, status])
  @@index([deletedAt])
  @@index([createdByUserId])
  @@map("workspaces")
}

model KnowledgeDocument {
  id           String                     @id @default(uuid()) @db.Uuid
  workspaceId  String                     @db.Uuid
  authorUserId String                     @db.Uuid
  title        String
  slug         String
  content      String                     @db.Text
  status       KnowledgeDocumentStatus    @default(ACTIVE)
  archivedAt   DateTime?                  @db.Timestamptz(6)
  version      Int                        @default(1)
  searchVector Unsupported("tsvector")?   @default(dbgenerated("(setweight(to_tsvector('simple'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, COALESCE(content, ''::text)), 'B'::\"char\"))")) @map("searchVector")
  createdAt    DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                   @updatedAt @db.Timestamptz(6)
  author       User                       @relation("KnowledgeDocumentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workspace    Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions     KnowledgeDocumentVersion[]
  attachments  KnowledgeAttachment[]

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId, status, updatedAt(sort: Desc), title, id], map: "knowledge_documents_list_page_idx")
  @@index([authorUserId, createdAt])
  @@index([searchVector], map: "knowledge_documents_active_search_idx", type: Gin, where: raw("(status = 'ACTIVE'::\"KnowledgeDocumentStatus\")"))
  @@map("knowledge_documents")
}

model KnowledgeDocumentVersion {
  id               String                 @id @default(uuid()) @db.Uuid
  documentId       String                 @db.Uuid
  versionNumber    Int
  title            String
  markdownContent  String                 @db.Text
  authorUserId     String                 @db.Uuid
  createdAt        DateTime               @default(now()) @db.Timestamptz(6)
  document         KnowledgeDocument      @relation(fields: [documentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author           User                   @relation("KnowledgeDocumentVersionAuthor", fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  chunkingJobs     KnowledgeChunkingJob[] @relation("KnowledgeChunkingJobDocumentVersion")
  chunkSets        KnowledgeChunkSet[]    @relation("KnowledgeChunkSetDocumentVersion")
  aiRuns           AiRun[]                @relation("AiRunKnowledgeDocumentVersion")
  groundedContexts AiRetrievalSnapshot[]  @relation("AiGroundedContextKnowledgeDocumentVersion")

  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("knowledge_document_versions")
}

model KnowledgeAttachment {
  id               String                              @id @default(uuid()) @db.Uuid
  workspaceId      String                              @db.Uuid
  documentId       String                              @db.Uuid
  uploaderUserId   String                              @db.Uuid
  originalFilename String
  storageKey       String                              @unique
  mimeType         String
  sizeBytes        BigInt
  sha256Checksum   String                              @db.Char(64)
  status           KnowledgeAttachmentStatus           @default(ACTIVE)
  processingStatus KnowledgeAttachmentProcessingStatus @default(UPLOADED)
  archivedAt       DateTime?                           @db.Timestamptz(6)
  version          Int                                 @default(1)
  createdAt        DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                            @updatedAt @db.Timestamptz(6)
  document         KnowledgeDocument                   @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict, map: "knowledge_attachments_document_workspace_fkey")
  uploader         User                                @relation("KnowledgeAttachmentUploader", fields: [uploaderUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workspace        Workspace                           @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  extractions      KnowledgeAttachmentExtraction[]
  processingJobs   DocumentProcessingJob[]

  @@unique([id, workspaceId])
  @@unique([documentId, sha256Checksum], map: "knowledge_attachments_active_document_checksum_key", where: raw("(status = 'ACTIVE'::\"KnowledgeAttachmentStatus\")"))
  @@index([documentId, status, createdAt])
  @@index([workspaceId, status])
  @@index([workspaceId, processingStatus])
  @@index([uploaderUserId, createdAt])
  @@map("knowledge_attachments")
}

model DocumentProcessingJob {
  id                String                         @id @default(uuid()) @db.Uuid
  attachmentId      String                         @db.Uuid
  workspaceId       String                         @db.Uuid
  requestedByUserId String                         @db.Uuid
  parserName        String
  parserVersion     String
  status            DocumentProcessingJobStatus    @default(QUEUED)
  errorMessage      String?                        @db.Text
  createdAt         DateTime                       @default(now()) @db.Timestamptz(6)
  startedAt         DateTime?                      @db.Timestamptz(6)
  completedAt       DateTime?                      @db.Timestamptz(6)
  attachment        KnowledgeAttachment            @relation(fields: [attachmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict, map: "document_processing_jobs_attachment_workspace_fkey")
  requestedBy       User                           @relation("DocumentProcessingJobRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  extraction        KnowledgeAttachmentExtraction?

  @@unique([attachmentId], map: "document_processing_jobs_active_attachment_key", where: raw("(status = ANY (ARRAY['QUEUED'::\"DocumentProcessingJobStatus\", 'PROCESSING'::\"DocumentProcessingJobStatus\"]))"))
  @@index([attachmentId, status, createdAt])
  @@index([workspaceId, status, createdAt])
  @@index([requestedByUserId, createdAt])
  @@map("document_processing_jobs")
}

model KnowledgeAttachmentExtraction {
  id               String                 @id @default(uuid()) @db.Uuid
  attachmentId     String                 @db.Uuid
  workspaceId      String                 @db.Uuid
  jobId            String                 @unique @db.Uuid
  extractionNumber Int
  parserName       String
  parserVersion    String
  extractedText    String                 @db.Text
  textSha256       String                 @db.Char(64)
  createdAt        DateTime               @default(now()) @db.Timestamptz(6)
  attachment       KnowledgeAttachment    @relation(fields: [attachmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict, map: "knowledge_attachment_extractions_attachment_workspace_fkey")
  job              DocumentProcessingJob  @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  chunkingJobs     KnowledgeChunkingJob[] @relation("KnowledgeChunkingJobAttachmentExtraction")
  chunkSets        KnowledgeChunkSet[]    @relation("KnowledgeChunkSetAttachmentExtraction")

  @@unique([attachmentId, extractionNumber], map: "knowledge_attachment_extractions_attachmentId_extractionNumber_")
  @@index([workspaceId, createdAt])
  @@map("knowledge_attachment_extractions")
}

model KnowledgeChunkingJob {
  id                     String                         @id @default(uuid()) @db.Uuid
  workspaceId            String                         @db.Uuid
  requestedByUserId      String                         @db.Uuid
  sourceType             KnowledgeChunkSourceType
  sourceId               String                         @db.Uuid
  sourceVersion          Int
  documentVersionId      String?                        @db.Uuid
  attachmentExtractionId String?                        @db.Uuid
  strategyKey            String
  strategyVersion        String
  status                 KnowledgeChunkingJobStatus     @default(QUEUED)
  errorMessage           String?                        @db.Text
  createdAt              DateTime                       @default(now()) @db.Timestamptz(6)
  startedAt              DateTime?                      @db.Timestamptz(6)
  completedAt            DateTime?                      @db.Timestamptz(6)
  workspace              Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy            User                           @relation("KnowledgeChunkingJobRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  documentVersion        KnowledgeDocumentVersion?      @relation("KnowledgeChunkingJobDocumentVersion", fields: [documentVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attachmentExtraction   KnowledgeAttachmentExtraction? @relation("KnowledgeChunkingJobAttachmentExtraction", fields: [attachmentExtractionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  chunkSet               KnowledgeChunkSet?

  @@unique([workspaceId, sourceType, sourceId, sourceVersion], map: "knowledge_chunking_jobs_active_source_key", where: raw("(status = ANY (ARRAY['QUEUED'::\"KnowledgeChunkingJobStatus\", 'PROCESSING'::\"KnowledgeChunkingJobStatus\"]))"))
  @@index([workspaceId, status, createdAt])
  @@index([sourceType, sourceId, sourceVersion, createdAt], map: "knowledge_chunking_jobs_sourceType_sourceId_sourceVersion_creat")
  @@index([requestedByUserId, createdAt])
  @@index([documentVersionId])
  @@index([attachmentExtractionId])
  @@map("knowledge_chunking_jobs")
}

model KnowledgeChunkSet {
  id                     String                         @id @default(uuid()) @db.Uuid
  workspaceId            String                         @db.Uuid
  sourceType             KnowledgeChunkSourceType
  sourceId               String                         @db.Uuid
  sourceVersion          Int
  documentVersionId      String?                        @db.Uuid
  attachmentExtractionId String?                        @db.Uuid
  strategyKey            String
  strategyVersion        String
  chunkCount             Int
  createdByJobId         String                         @unique @db.Uuid
  createdAt              DateTime                       @default(now()) @db.Timestamptz(6)
  workspace              Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByJob           KnowledgeChunkingJob           @relation(fields: [createdByJobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  documentVersion        KnowledgeDocumentVersion?      @relation("KnowledgeChunkSetDocumentVersion", fields: [documentVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attachmentExtraction   KnowledgeAttachmentExtraction? @relation("KnowledgeChunkSetAttachmentExtraction", fields: [attachmentExtractionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  chunks                 KnowledgeChunk[]
  embeddingJobs          KnowledgeEmbeddingJob[]
  embeddingSets          KnowledgeEmbeddingSet[]
  aiRunCitations         AiRunCitation[]

  @@index([workspaceId, createdAt])
  @@index([sourceType, sourceId, sourceVersion, createdAt], map: "knowledge_chunk_sets_sourceType_sourceId_sourceVersion_createdA")
  @@index([strategyKey, strategyVersion])
  @@index([documentVersionId])
  @@index([attachmentExtractionId])
  @@map("knowledge_chunk_sets")
}

model KnowledgeChunk {
  id             String                   @id @default(uuid()) @db.Uuid
  chunkSetId     String                   @db.Uuid
  ordinal        Int
  text           String                   @db.Text
  characterStart Int?
  characterEnd   Int?
  tokenEstimate  Int
  sha256         String                   @db.Char(64)
  metadata       Json                     @default("{}") @db.JsonB
  searchVector   Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, COALESCE(text, ''::text))")) @map("searchVector")
  createdAt      DateTime                 @default(now()) @db.Timestamptz(6)
  chunkSet       KnowledgeChunkSet        @relation(fields: [chunkSetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  embeddings     KnowledgeEmbedding[]

  @@unique([chunkSetId, ordinal])
  @@index([chunkSetId])
  @@index([searchVector], map: "knowledge_chunks_search_idx", type: Gin)
  @@map("knowledge_chunks")
}

model KnowledgeEmbeddingJob {
  id                String                      @id @default(uuid()) @db.Uuid
  workspaceId       String                      @db.Uuid
  chunkSetId        String                      @db.Uuid
  requestedByUserId String                      @db.Uuid
  providerKey       String
  modelKey          String
  modelVersion      String
  dimensions        Int
  status            KnowledgeEmbeddingJobStatus @default(QUEUED)
  errorMessage      String?                     @db.Text
  createdAt         DateTime                    @default(now()) @db.Timestamptz(6)
  startedAt         DateTime?                   @db.Timestamptz(6)
  completedAt       DateTime?                   @db.Timestamptz(6)
  workspace         Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  chunkSet          KnowledgeChunkSet           @relation(fields: [chunkSetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy       User                        @relation("KnowledgeEmbeddingJobRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  embeddingSet      KnowledgeEmbeddingSet?

  @@unique([workspaceId, chunkSetId, providerKey, modelKey, modelVersion], map: "knowledge_embedding_jobs_active_generation_key", where: raw("(status = ANY (ARRAY['QUEUED'::\"KnowledgeEmbeddingJobStatus\", 'PROCESSING'::\"KnowledgeEmbeddingJobStatus\"]))"))
  @@index([workspaceId, status, createdAt])
