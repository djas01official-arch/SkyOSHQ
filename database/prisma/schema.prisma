  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy            User                  @relation("AiOrchestrationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  conversation         AiConversation?       @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userMessage          AiMessage?            @relation(fields: [userMessageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  groundedContext      AiRetrievalSnapshot   @relation(fields: [groundedContextId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  finalRun             AiRun?                @relation("AiOrchestrationFinalRun", fields: [finalRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  runs                 AiRun[]               @relation("AiOrchestrationRuns")

  @@index([workspaceId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([groundedContextId])
  @@index([conversationId, createdAt])
  @@index([userMessageId])
  @@map("ai_orchestrations")
}

model AiRunCitation {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshotId               String                   @db.Uuid
  citationId               String
  sourceType               KnowledgeChunkSourceType
  sourceId                 String                   @db.Uuid
  documentSlug             String
  documentVersion          Int?
  attachmentId             String?                  @db.Uuid
  filename                 String?
  extractionVersion        Int?
  chunkSetId               String?                  @db.Uuid
  chunkOrdinal             Int
  characterStart           Int?
  characterEnd             Int?
  displayedExcerpt         String                   @db.Text
  displayedExcerptChecksum String                   @db.Char(64)
  createdAt                DateTime                 @default(now()) @db.Timestamptz(6)
  snapshot                 AiRetrievalSnapshot      @relation(fields: [snapshotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  chunkSet                 KnowledgeChunkSet?       @relation(fields: [chunkSetId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([snapshotId, citationId])
  @@unique([snapshotId, chunkSetId, chunkOrdinal])
  @@index([sourceType, sourceId])
  @@index([attachmentId])
  @@index([chunkSetId])
  @@map("ai_run_citations")
}
