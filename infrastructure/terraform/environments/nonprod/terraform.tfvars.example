# Copy this file to ignored terraform.tfvars and replace only non-secret placeholders.
# Secret VALUES never belong in tfvars. Populate Secret Manager versions separately
# and pin only their numeric version IDs below when the web runtime is ready.
project_id            = "replace-with-gcp-project-id"
knowledge_bucket_name = "replace-with-globally-unique-skyos-nonprod-bucket"

# runtime_image must be an immutable Artifact Registry digest, for example:
# runtime_image = "europe-west1-docker.pkg.dev/replace-with-gcp-project-id/skyos-np-runtime/skyos@sha256:<64-hex-digest>"

# FAST remains the deployment default. Enabling BALANCED, DEEP, CRITICAL, or AUTO
# requires a pinned OPENAI_API_KEY plus Anthropic authentication. Anthropic can use
# either a pinned API-key version or workload-specific Workload Identity Federation.
ai_chat_mode = "FAST"

# Keep the application login disabled until the migrator role-bootstrap job has
# created and verified skyos_application_role. The actual password must NEVER be
# placed in terraform.tfvars; supply it only as the ephemeral
# TF_VAR_application_database_password value during the controlled apply.
enable_application_database_user        = false
application_database_roles_bootstrapped = false
application_database_password_version    = 0

# Keep the service disabled until DATABASE_URL, AUTH_SECRET, and AUTH_GOOGLE_SECRET
# exist in Secret Manager and their reviewed versions are pinned below.
enable_web_service         = false
web_allow_unauthenticated  = false
web_google_oauth_client_id = ""

# Optional Anthropic Workload Identity Federation identifiers. These values are
# not secrets. Use separate federation rules for the web and durable worker
# Google service accounts so each rule can be bound to one exact workload identity.
anthropic_federation_rule_id        = ""
anthropic_worker_federation_rule_id = ""
anthropic_organization_id           = ""
anthropic_service_account_id        = ""
anthropic_workspace_id              = ""

web_secret_versions = {
  # DATABASE_URL       = "1"
  # AUTH_SECRET        = "1"
  # AUTH_GOOGLE_SECRET = "1"
  # OPENAI_API_KEY     = "1"
  # ANTHROPIC_API_KEY  = "1"
  # GEMINI_API_KEY     = "1"
}
