{
  "name": "skyos",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project database/tsconfig.json",
    "check": "pnpm format && pnpm lint && pnpm typecheck && turbo run lint typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:test:migrate": "tsx database/scripts/migrate-test.ts",
    "db:test": "pnpm db:test:migrate && tsx --test --test-concurrency=1 database/tests/tenancy.integration.test.ts database/tests/authentication.integration.test.ts database/tests/organization-context.integration.test.ts database/tests/audit-events.integration.test.ts database/tests/knowledge-documents.integration.test.ts database/tests/knowledge-attachments.integration.test.ts database/tests/document-processing.integration.test.ts apps/web/components/knowledge/markdown-document.test.tsx"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "argon2": "^0.45.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@skyos/config": "workspace:*",
    "@types/node": "^24.10.1",
    "dotenv": "^17.0.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "prisma": "^7.7.0",
    "tsx": "^4.20.0",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
