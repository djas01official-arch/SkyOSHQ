{
  "schemaVersion": 1,
  "bundleFormat": "skyos-secrets-recovery-v1",
  "encryption": {
    "tool": "age",
    "mode": "recipient",
    "recipientEnvironmentVariable": "SKYOS_RECOVERY_AGE_RECIPIENT",
    "privateIdentityPolicy": "offline-only-never-github-never-drive"
  },
  "secrets": [
    {
      "name": "AUTH_SECRET",
      "environmentVariable": "AUTH_SECRET",
      "source": "local-env-or-gcp-secret-manager",
      "includeInLocalEnvBundle": true,
      "recoveryStrategy": "encrypted-backup-and-rotate-after-emergency-recovery"
    },
    {
      "name": "AUTH_GOOGLE_SECRET",
      "environmentVariable": "AUTH_GOOGLE_SECRET",
      "source": "gcp-secret-manager",
      "includeInLocalEnvBundle": true,
      "recoveryStrategy": "encrypted-backup-and-rotate-if-compromised"
    },
    {
      "name": "OPENAI_API_KEY",
      "environmentVariable": "OPENAI_API_KEY",
      "source": "gcp-secret-manager",
      "includeInLocalEnvBundle": true,
      "recoveryStrategy": "encrypted-backup-and-rotate-if-compromised"
    },
    {
      "name": "ANTHROPIC_API_KEY",
      "environmentVariable": "ANTHROPIC_API_KEY",
      "source": "gcp-secret-manager",
      "includeInLocalEnvBundle": true,
      "recoveryStrategy": "encrypted-backup-and-rotate-if-compromised"
    },
    {
      "name": "GEMINI_API_KEY",
      "environmentVariable": "GEMINI_API_KEY",
      "source": "gcp-secret-manager",
      "includeInLocalEnvBundle": true,
      "recoveryStrategy": "encrypted-backup-and-rotate-if-compromised"
    },
    {
      "name": "skyos-np-db-migrator-password",
      "environmentVariable": null,
      "source": "gcp-secret-manager",
      "includeInLocalEnvBundle": false,
      "recoveryStrategy": "recover-from-secret-manager-version-or-reset-and-rotate"
    }
  ]
}
